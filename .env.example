# En Railway estas van en Variables (una por una). Este archivo solo es la lista.

# ============ OBLIGATORIAS ============

# Carpeta de Drive con las fotos (ID o el enlace completo de la carpeta).
# Las fotos se llaman igual que el codigo: 892B-D2.jpg, 9051-6.png ... (tambien busca en subcarpetas)
DRIVE_FOLDER_ID=

# JSON de la cuenta de servicio de Google (pegalo completo, o su base64).
# Comparte la carpeta de fotos con el correo "client_email" de esa cuenta, permiso Lector.
# Puedes reutilizar la misma cuenta de servicio de TablasK.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ============ OPCIONALES ============

# Si la pones, quien use la app debe escribir esta clave (util para clientes y vendedores).
ACCESS_CODE=

# Titulo de la pagina web
APP_NAME=Generador de catálogo

# Titulo por defecto del PDF
CATALOG_TITLE=Catálogo

# Sale en el pie del PDF si no hay FOOTER_TEXT
BRAND_NAME=

# Color del encabezado del PDF y de la web
BRAND_COLOR=#E41F29

# Pie del PDF, ej: Pedidos por WhatsApp +57 300 000 0000
FOOTER_TEXT=

# Maximo de codigos por PDF
MAX_CODES=150

# Lado mayor de cada foto dentro del PDF (mas alto = PDF mas pesado)
IMG_MAX_PX=900
JPEG_QUALITY=80

# Cada cuantos segundos vuelve a listar la carpeta de Drive
INDEX_TTL_SECONDS=300

# Cuantas horas dura el enlace de cada PDF
PDF_TTL_HOURS=24

# Solo para pruebas locales (en vez de Drive): carpeta del computador con las fotos
# LOCAL_IMAGES_DIR=/ruta/a/las/fotos

# Logo opcional: pon un PNG en static/logo.png (se ve mejor si es blanco o transparente).
